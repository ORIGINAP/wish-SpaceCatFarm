    \uC788\uC73C\uBA74 \uC804\uAE30\uAC00 \uB4E4\uC5B4\uC640\uC694). \uD654\uBA74
    \uC704 \uAC00\uC6B4\uB370 \uBB38\uBA85 \uC54C\uB9BC\uD310\uC744 \uB204\uB974\uBA74
    \uB2E4\uC74C \uB2E8\uACC4 \uC870\uAC74\uC774 \uBCF4\uC5EC\uC694. \uB2E8\uACC4\uB9C8\uB2E4
    \uBC1C\uC804 \uC790\uAE08(\uCF54\uC778)\uB3C4 \uBAA8\uC544\uC57C \uD574\uC694.
