--- !u!114 &1810218318
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1810218316}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63c1b91d613cc5f43b262ce48704f1ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HelpUI
  panelWidth: 380
  animDuration: 0.22
  closeKey: 27
  topDescription: "\uC5B4\uC11C\uC624\uC138\uC694! \uB2F9\uC2E0\uC740 \uACE0\uC591\uACE0\uC591\uBCC4\uC758
    \uAC1C\uCC99\uC790\uC785\uB2C8\uB2E4.\n\uC790\uC6D0\uC744 \uC218\uC9D1\uD558\uACE0,
    \uB2F9\uC2E0\uC758 \uC6B0\uC8FC \uD50C\uB7AB\uD3FC\uC744 \uAC1C\uCC99\uD574\uB098\uAC00\uC138\uC694."
  helpEntries:
  - title: "\uAE30\uBCF8 \uC870\uC791"
    content: "\u2022 <b>WASD</b>: \uC774\uB3D9\n\u2022 <b>\uC88C\uD074\uB9AD</b>:
      \uD0C0\uC77C \uC124\uCE58 / \uC790\uC6D0 \uCC44\uAD74\n\u2022 <b>\uC6B0\uD074\uB9AD</b>:
      \uD0C0\uC77C \uC81C\uAC70\n\u2022 <b>R</b>: \uD0C0\uC77C \uD68C\uC804\n\u2022
      <b>F</b>: \uC0C1\uD638\uC791\uC6A9 (\uC5F0\uB8CC \uC8FC\uC785 \uB4F1)"
    isOpen: 0
  - title: "\uC778\uBCA4\uD1A0\uB9AC & \uC81C\uC791"
    content: "\u2022 <b>I</b>: \uC778\uBCA4\uD1A0\uB9AC \uC5F4\uAE30\n\u2022 <b>C</b>:
      \uC81C\uC791\uCC3D \uC5F4\uAE30\n\u2022 \uC544\uC774\uD15C\uC744 \uB4DC\uB798\uADF8\uD558\uC5EC
      \uC2AC\uB86F \uAC04 \uC774\uB3D9\uC774 \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    isOpen: 0
  - title: "\uC5D0\uB108\uC9C0 \uC2DC\uC2A4\uD15C"
    content: "\u2022 <b>\uBC1C\uC804\uAE30</b>: \uC5F0\uB8CC\uB97C \uC18C\uBAA8\uD574
      \uC8FC\uBCC0 \uC804\uC120\uC744 \uCDA9\uC804\uD569\uB2C8\uB2E4.\n\u2022 <b>\uBC30\uD130\uB9AC</b>:
      \uC804\uAE30\uB97C \uC800\uC7A5\uD558\uACE0 \uC8FC\uBCC0 \uAE30\uAE30\uC5D0
      \uACF5\uAE09\uD569\uB2C8\uB2E4.\n\u2022 \uAE30\uAE30\uB4E4\uC740 \uC804\uB825
      \uBC94\uC704 \uB0B4\uC5D0 \uC788\uC5B4\uC57C \uC791\uB3D9\uD569\uB2C8\uB2E4."
    isOpen: 0
  - title: "\uC790\uC6D0 \uCC44\uAD74"
    content: "\u2022 \uC790\uC6D0 \uBE14\uB85D\uC744 <b>\uC88C\uD074\uB9AD \uC720\uC9C0</b>\uD558\uC5EC
      \uCC44\uAD74\uD558\uC138\uC694.\n\u2022 \uB5A8\uC5B4\uC9C4 \uC544\uC774\uD15C\uC740
      \uD50C\uB808\uC774\uC5B4 \uADFC\uCC98\uB85C \uAC00\uBA74 \uC790\uB3D9\uC73C\uB85C
      \uC2B5\uB4DD\uB429\uB2C8\uB2E4."
    isOpen: 0
  - title: "\uC544\uC774\uD15C \uC81C\uC791"
    content: "\uC5EC\uB7EC \uC544\uC774\uD15C\uC744 \uC870\uD569\uD558\uC5EC \uC0C1\uC704
      \uC544\uC774\uD15C\uC744 \uB9CC\uB4E4\uC5B4\uBCF4\uC138\uC694. \uB354 \uC88B\uC740
      \uC544\uC774\uD15C\uC744 \uD1B5\uD574 \uD5A5\uC0C1\uB41C \uC81C\uC791\uC774
      \uAC00\uB2A5\uD569\uB2C8\uB2E4."
    isOpen: 0
